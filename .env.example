# Telegram Bot Configuration
BOTTOKEN=your_telegram_bot_token_here
BOTTOKEN_PRIO=your_priority_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ScrapeOps API Key
SCRAPEOPS_API_KEY=your_scrapeops_api_key_here

# Database Configuration
FILE_LOCATION=/home/youruser/kleinanzeigenAlert.db

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOGGING=ERROR

# Location Filter (optional)
# Format: "distance1,zip11,zip12,...zip1N-dist2,zip21,...,zip2N"
# Example: "50,10115,10117,10119-100,10115,10243"
LOCATION_FILTER=

# Message Configuration
SOURCE_INDICATOR=

# Search Configuration
TARGET_MODE_BENEFIT=0.2
FORCE_PRIO_GEOLOC=1
